// Автоматическое преобразование сохраненных данных
function convertSavedEvent(event) {
    if (!event || !event.location) return event;

    // Если старый формат
    if (event.location.lat !== undefined || event.location.lon !== undefined) {
        return {
            ...event,
            location: {
                name: event.location.name || "Event Location",
                latitude: event.location.lat || 55.7558,
                longitude: event.location.lon || 37.6173,
                radius: event.location.radius || 0,
                type: event.location.type || "OTHER"
            }
        };
    }
    return event;
}

// При сохранении преобразуем
const originalSet = pm.collectionVariables.set;
pm.collectionVariables.set = function(key, value) {
    if (key === 'response' && value && typeof value === 'object') {
        value = convertSavedEvent(value);
    }
    return originalSet.call(this, key, value);
};